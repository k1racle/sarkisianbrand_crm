worker_processes auto;
pid /tmp/nginx.pid;
# The WebSocket token is in the query string. Do not write request lines or
# upstream error details, which can include the original URI, to logs.
error_log /dev/null crit;
events { worker_connections 1024; }
http {
  server_tokens off;
  access_log off;
  resolver 127.0.0.11 valid=5s ipv6=off;
  resolver_timeout 3s;
  client_max_body_size 1k;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 8080;
    set $lms_api backend:3000;
    set $lms_server livekit-lms:7880;
    location = /_lms_authorize {
      internal;
      proxy_pass http://$lms_api/api/v1/lms-live-gateway/authorize;
      proxy_pass_request_body off;
      proxy_pass_request_headers off;
      proxy_set_header Content-Length "";
      proxy_set_header X-LMS-Media-Token $lms_media_token;
      proxy_set_header X-LMS-Gateway-Key "${LMS_GATEWAY_KEY}";
      proxy_connect_timeout 2s;
      proxy_read_timeout 3s;
      proxy_send_timeout 3s;
      proxy_intercept_errors on;
      access_log off;
    }
    location ~ "^/rtc(?:/v1)?(?:/validate)?$" {
      if ($request_method != GET) { return 405; }
      # nginx and LiveKit must authenticate the same query parameter. Reject
      # encoded parameter names and repeated/case-variant access_token keys.
      if ($args ~* "(^|&)[^=&]*%[^=&]*=") { return 400; }
      if ($args ~* "(^|&)access_token=[^&]*&([^&]*&)*access_token=") { return 400; }
      if ($args !~ "(^|&)access_token=") { return 400; }
      # Set only on the original request: setting this in server scope would
      # overwrite it when the internal authorization subrequest is evaluated.
      set $lms_media_token $arg_access_token;
      auth_request /_lms_authorize;
      proxy_pass http://$lms_server$request_uri;
      proxy_http_version 1.1;
      proxy_set_header Authorization "";
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_connect_timeout 3s;
      proxy_read_timeout 3600s;
      proxy_send_timeout 60s;
      proxy_buffering off;
      access_log off;
    }
    location / { return 404; }
  }
}
