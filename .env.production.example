# Generate real secrets with: node scripts/init-production-env.cjs your-domain.ru admin@your-domain.ru
COMPOSE_PROJECT_NAME=sarkisian-crm-production
SITE_HOST=
ACME_EMAIL=
DB_PASSWORD=
DB_MIGRATION_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
RELEASE_IMAGE_PREFIX=sarkisian-crm
RELEASE_TAG=local
# Enable individual external processes only after configuring and accepting them.
SEO_INDEXING_ENABLED=false
ECOSYSTEM_AUTOMATION_ENABLED=false
# Enable WB polling only after API validation; sandbox import requires an isolated test database.
WB_FBS_AUTOPOLL_ENABLED=false
WB_FBS_ALLOW_SANDBOX_IMPORT=false
STOREFRONT_EXTERNAL_CALLS_ENABLED=false
LMS_COURSE_SALES_ENABLED=false
# Enable only on an isolated test installation: test-provider payments must
# never mark real production orders as paid.
PAYMENT_TEST_SETTLEMENT_ENABLED=false
MAIL_DELIVERY_ENABLED=false
LOYALTY_MAINTENANCE_ENABLED=false
