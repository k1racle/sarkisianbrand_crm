  @@index([provider, audience])
  @@index([status])
}

model BotCommand {
  id               String            @id @default(uuid())
  slug             String            @unique
  command          String
  title            String
  description      String?
  audiences        BotAudience[]
  channels         String[]
  handlerKey       String
  responseTemplate String?
  requiresAuth     Boolean           @default(true)
  isEnabled        Boolean           @default(true)
  sortOrder        Int               @default(100)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           BotWebhookEvent[]

  @@index([isEnabled, sortOrder])
}

model BotIdentity {
  id             String        @id @default(uuid())
  provider       String
  audience       BotAudience
  externalUserId String
  externalChatId String?
  displayName    String?
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isVerified     Boolean       @default(false)
  metadata       Json?
  verifiedAt     DateTime?
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, audience, externalUserId])
  @@index([userId])
  @@index([customerId])
  @@index([organizationId])
  @@index([provider, audience, isVerified])
}

model BotWebhookEvent {
  id              String               @id @default(uuid())
  integrationId   String
  integration     EcosystemIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider        String
  audience        BotAudience
  externalEventId String
  externalUserId  String?
  externalChatId  String?
  eventType       String?
  commandText     String?
  commandId       String?
  command         BotCommand?          @relation(fields: [commandId], references: [id], onDelete: SetNull)
  status          BotEventStatus       @default(RECEIVED)
  payload         Json
  responseText    String?
  error           String?
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?
  updatedAt       DateTime             @updatedAt

  @@unique([integrationId, externalEventId])
  @@index([status, receivedAt])
  @@index([provider, audience, receivedAt])
  @@index([externalUserId])
  @@index([commandId])
}

