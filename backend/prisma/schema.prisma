// Sarkisian Brand Backend - Prisma Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum UserRole {
  ADMIN
  CONTENT_MANAGER
  MANAGER_B2B
  MANAGER_SALES
  MARKETPLACE_MANAGER
  SUPERVISOR
  EXECUTIVE
  IT_SUPPORT
  CURATOR
  WAREHOUSE
  CUSTOMER_B2C
  CUSTOMER_B2B
}

enum TicketSource {
  EMPLOYEE
  B2C
  B2B
  SYSTEM
}

enum TicketStatus {
  NEW
  OPEN
  WAITING_REQUESTER
  WAITING_INTERNAL
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum OrganizationStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  ARCHIVED
}

enum OrganizationMemberRole {
  OWNER
  BUYER
  ACCOUNTANT
  EMPLOYEE
}

enum B2BClientStatus {
  ACTIVE
  ARCHIVED
}

enum B2BBookingStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  NEW
  CONFIRMED
  PAYMENT_WAITING
  PAID
  ASSEMBLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  WEB
  B2B
  WILDBERRIES
  OZON
  YANDEX_MARKET
  MEGAMARKET
  MANUAL
  ONE_C
}

enum MarketplaceChannel {
  WILDBERRIES
  OZON
  YANDEX_MARKET
  MEGAMARKET
}

enum MarketplaceOrderStatus {
  NEW
  CONFIRMED
  ASSEMBLING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  OVERDUE
  CANCELLED
}

enum CrmChatType {
  TEAM
  PRIVATE
}

enum PlatformChatAttachmentKind {
  FILE
  IMAGE
  AUDIO
  ENTITY
}

enum Currency {
  RUB
  USD
  EUR
  KZT
}

enum Locale {
  ru
  en
  kz
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DataEntityType {
  USER
  CUSTOMER
  ORGANIZATION
  PRODUCT
  CATEGORY
  LEAD
  TASK
  HELPDESK_TICKET
  B2B_CLIENT
  B2B_SERVICE
  BOT_COMMAND
}

enum TrashEntryStatus {
  TRASHED
  RESTORED
  PURGED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum JobRunStatus {
  WAITING
  ACTIVE
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum IntegrationCategory {
  MARKETPLACE
  DELIVERY
  ERP
  PAYMENT
  FISCAL
  COMMUNICATION
  BOT
}

enum IntegrationStatus {
  NOT_CONFIGURED
  DISABLED
  CONFIGURED
  CONNECTED
  ERROR
}

enum IntegrationEnvironment {
  TEST
  PRODUCTION
}

enum BotAudience {
  EMPLOYEE
  B2C
  B2B
}

enum BotEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  REQUIRES_AUTH
  COMPLETED
  IGNORED
  FAILED
}

// ===================== CORE MODELS =====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(CUSTOMER_B2C)
  isActive  Boolean  @default(true)

  locale  Locale  @default(ru)
  country String? @default("RU")
  city    String?
  timezone               String   @default("Europe/Moscow")
  avatarStorageKey       String?
  notificationPreferences Json?
  forcePasswordChange    Boolean  @default(false)
  passwordChangedAt      DateTime?

  b2bProfile              B2BProfile?
  orders                  Order[]
  cart                    Cart?
  tasksAssigned           Task[]               @relation("AssignedTasks")
  tasksCreated            Task[]               @relation("CreatedTasks")
  taskTemplatesAssigned   CrmTaskTemplate[]    @relation("TaskTemplateAssignee")
  taskTemplatesCreated    CrmTaskTemplate[]    @relation("TaskTemplateCreator")
  taskReminders           CrmTaskReminder[]    @relation("TaskReminderRecipient")
  interactions            Interaction[]
  sessions                Session[]
  managedB2BClients       B2BProfile[]         @relation("B2BManagerClients")
  managedOrders           Order[]              @relation("ManagerOrders")
  managedLeads            Lead[]               @relation("ManagerLeads")
  createdLeads            Lead[]               @relation("CrmLeadCreator")
  taskComments            CrmTaskComment[]
  crmChannelsCreated      CrmChatChannel[]     @relation("CrmChannelCreator")
  crmChatMemberships      CrmChatMember[]
  crmChatMessages         CrmChatMessage[]     @relation("CrmMessageAuthor")
  enrollments             Enrollment[]
  bookings                Booking[]
  loyaltyAccount          LoyaltyAccount?
  partnerProfiles         PartnerParticipant[]
  ticketsRequested        HelpdeskTicket[]     @relation("TicketRequester")
  ticketsAssigned         HelpdeskTicket[]     @relation("TicketAssignee")
  ticketComments          HelpdeskComment[]
  customer                Customer?
  organizationMemberships OrganizationMember[]
  managedOrganizations    Organization[]       @relation("OrganizationAccountManager")
  permissionOverrides     UserPermission[]
  auditLogs               AuditLog[]           @relation("AuditActor")
  botIdentities           BotIdentity[]
  profileChangeRequests   ProfileChangeRequest[] @relation("ProfileChangeRequester")
  profileChangeReviews    ProfileChangeRequest[] @relation("ProfileChangeReviewer")
  passwordResetTokens     PasswordResetToken[]   @relation("PasswordResetOwner")
  passwordResetsCreated   PasswordResetToken[]   @relation("PasswordResetCreator")
  dataTrashActions        DataTrashEntry[]        @relation("DataTrashActor")
  storefrontAddresses     StorefrontAddress[]
  productFavorites        ProductFavorite[]
  socialLoginTickets      SocialLoginTicket[]
  mediaAssets             MediaAsset[]
  siteContentRevisions    SiteContentRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
}

model ProfileChangeRequest {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation("ProfileChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
  requestedData   Json
  status          ProfileChangeStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?               @relation("ProfileChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewComment   String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("PasswordResetOwner", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?     @relation("PasswordResetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model OAuthLoginState {
  id           String    @id @default(uuid())
  stateHash    String    @unique
  provider     String
  codeVerifier String?
  returnUrl    String    @default("/account")
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([provider, expiresAt])
  @@index([expiresAt, usedAt])
}

model SocialLoginTicket {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model DataTrashEntry {
  id                String           @id @default(uuid())
  entityType        DataEntityType
  entityId          String
  displayName       String
  snapshot          Json
  previousState     Json
  dependencySummary Json
  status            TrashEntryStatus @default(TRASHED)
  reason            String?
  actorId           String?
  actor             User?            @relation("DataTrashActor", fields: [actorId], references: [id], onDelete: SetNull)
  trashedAt         DateTime          @default(now())
  purgeAfter        DateTime
  restoredAt        DateTime?
  purgedAt          DateTime?
  updatedAt         DateTime          @updatedAt

  @@index([status, purgeAfter])
  @@index([entityType, entityId, status])
  @@index([actorId, trashedAt])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  resource    String
  action      String
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  createdAt   DateTime         @default(now())

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  scope        Json?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  resource      String
  resourceId    String?
  route         String?
  correlationId String?
  ipAddress     String?
  userAgent     String?
  payload       Json?
  result        Json?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model B2BProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  companyName  String?
  inn          String? @unique
  kpp          String?
  legalAddress String?
  managerId    String?
  manager      User?   @relation("B2BManagerClients", fields: [managerId], references: [id])

  discountTier Float   @default(0.0)
  creditLimit  Decimal @default(0.00) @db.Decimal(15, 2)
  isVerified   Boolean @default(false)

  orders Order[]
  leads  Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String         @id @default(uuid())
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  birthday        DateTime?
  normalizedEmail String?
  normalizedPhone String?
  status          CustomerStatus @default(ACTIVE)
  segment         String?
  source          String         @default("WEB")

  externalIdentities      CustomerExternalIdentity[]
  organizationMemberships OrganizationMember[]
  orders                  Order[]
  leads                   Lead[]
  interactions            Interaction[]
  helpdeskTickets         HelpdeskTicket[]
  botIdentities           BotIdentity[]
  tasks                   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([status, segment])
}

model CustomerExternalIdentity {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([customerId])
}

model Organization {
  id               String             @id @default(uuid())
  name             String
  legalName        String?
  inn              String?            @unique
  kpp              String?
  legalAddress     String?
  status           OrganizationStatus @default(PROSPECT)
  discountTier     Float              @default(0)
  creditLimit      Decimal            @default(0.00) @db.Decimal(15, 2)
  accountManagerId String?
  accountManager   User?              @relation("OrganizationAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  external1CId     String?            @unique
  lastSync1CAt     DateTime?

  members          OrganizationMember[]
  orders           Order[]
  leads            Lead[]
  helpdeskTickets  HelpdeskTicket[]
  botIdentities    BotIdentity[]
  businessClients  B2BClient[]
  businessServices B2BService[]
  businessBookings B2BBooking[]
  salonBookingSetting SalonBookingSetting?
  salonPresentation SalonPresentation?
  partnerRegistration PartnerBusinessRegistration?
  tasks            Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([accountManagerId])
}

model OrganizationMember {
  id               String                 @id @default(uuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  role             OrganizationMemberRole @default(EMPLOYEE)
  jobTitle         String?
  canOrder         Boolean                @default(true)
  canSeeFinance    Boolean                @default(false)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  assignedBookings B2BBooking[]           @relation("B2BBookingMaster")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([customerId])
}

model B2BClient {
  id                    String          @id @default(uuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String?
  phone                 String?
  email                 String?
  birthday              DateTime?
  notes                 String?
  tags                  String[]        @default([])
  source                String          @default("MANUAL")
  status                B2BClientStatus @default(ACTIVE)
  consentPersonalDataAt DateTime?
  lastVisitAt           DateTime?
  totalVisits           Int             @default(0)
  totalSpent            Decimal         @default(0.00) @db.Decimal(15, 2)
  bookings              B2BBooking[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, lastVisitAt])
}

model B2BService {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  duration       Int
  price          Decimal      @db.Decimal(15, 2)
  color          String       @default("#f8604a")
  isActive       Boolean      @default(true)
  bookings       B2BBooking[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
}

model SalonBookingSetting {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  timeZone       String       @default("Europe/Moscow")
  startMinute    Int          @default(540)
  endMinute      Int          @default(1200)
  slotStep       Int          @default(15)
  horizonDays    Int          @default(30)
  workingDays    Int[]         @default([1, 2, 3, 4, 5, 6])
  masterIds      String[]      @default([])
  weeklySchedule Json @default("[]")
  updatedAt      DateTime      @updatedAt
}

model SalonPresentation {
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName String @default("")
  address String @default("")
  phones String[] @default([])
  emails String[] @default([])
  socialLinks Json @default("[]")
  logoBytes Bytes?
  logoMime String?
  logoVersion String?
  updatedAt DateTime @updatedAt
}

model SalonSubscriptionSetting {
  key String @id @default("main")
  name String @default("Кабинет салона")
  monthlyPrice Decimal @default(0) @db.Decimal(12, 2)
  annualPrice Decimal @default(0) @db.Decimal(12, 2)
  freeAccess Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model B2BBooking {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         B2BClient           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId      String
  service        B2BService          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  masterMemberId String?
  masterMember   OrganizationMember? @relation("B2BBookingMaster", fields: [masterMemberId], references: [id], onDelete: SetNull)
  startTime      DateTime
  endTime        DateTime
  status         B2BBookingStatus    @default(NEW)
  notes          String?
  reminderSentAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, startTime])
  @@index([organizationId, status])
  @@index([clientId, startTime])
  @@index([masterMemberId, startTime])
}

// ===================== CATALOG =====================

model Category {
  id       String     @id @default(uuid())
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  nameRu      String
  nameEn      String?
  slug        String  @unique
  description Json?
  imageUrl    String?

  products ProductCategory[]
  seo      SeoData?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model StorefrontSetting {
  key              String   @id @default("main")
  catalogMenu Json?
  catalogMenuRevision Int @default(0)
  categoryTreeRevision Int @default(0)
  productBadges Json?
  productBadgesRevision Int @default(0)
  siteContent Json?
  siteContentRevision Int @default(0)
  announcementText String   @default("SARKISIAN BRAND – это официальный интернет-магазин скоростного мастера-блогера Светланы Саркисян")
  updatedAt        DateTime @default(now()) @updatedAt
}

model SiteContentRevision {
  id String @id @default(uuid())
  revision Int @unique
  snapshot Json
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MediaAsset {
  id String @id @default(uuid())
  filename String @unique
  originalName String
  mime String
  size Int
  width Int?
  height Int?
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt, id])
  @@index([createdById])
}

model StorefrontBanner {
  id             String   @id @default(uuid())
  title          String?
  subtitle       String?
  buttonLabel    String?  @default("Перейти в каталог")
  linkUrl        String?  @default("/catalog")
  imageUrl       String
  mobileImageUrl String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([isActive, sortOrder])
}

model StorefrontPage {
  slug           String   @id
  title          String
  eyebrow        String   @default("")
  lead           String   @default("")
  seoDescription String?
  blocks         Json
  isActive       Boolean  @default(true)
  reviewRequired Boolean  @default(false)
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StorefrontMenuItem {
  id        String   @id @default(uuid())
  label     String
  url       String
  newTab    Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model StorefrontSocialLink {
  id        String   @id @default(uuid())
  name      String
  iconKey   String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id         String  @id @default(uuid())
  sku        String  @unique
  vendorCode String?
  productType String @default("PHYSICAL")
  giftCardValidityDays Int?

  nameRu        String
  nameEn        String?
  descriptionRu String?
  descriptionEn String?
  purposes      String[] @default([])
  features      String[] @default([])
  badgeIds      String[] @default([])
  slug          String  @unique

  basePrice Decimal  @db.Decimal(15, 2)
  currency  Currency @default(RUB)

  variants   ProductVariant[]
  categories ProductCategory[]
  images     ProductImage[]
  favorites  ProductFavorite[]

  externalId String? @unique
  isSynced   Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seo SeoData?

  @@index([slug])
  @@index([externalId])
  @@index([purposes], type: Gin)
  @@index([features], type: Gin)
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String
  options Json

  price    Decimal @db.Decimal(15, 2)
  salePrice Decimal? @db.Decimal(15, 2)
  saleStartsAt DateTime?
  saleEndsAt DateTime?
  stock    Int     @default(0)
  reserved Int     @default(0)
  isActive Boolean @default(true)

  sku String @unique

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  @@id([productId, categoryId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model ProductFavorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
  @@index([userId, createdAt])
}

model StorefrontAddress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Основной")
  recipientName String
  phone         String
  city          String
  street        String
  house         String
  apartment     String?
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, isDefault])
}

// ===================== CART & ORDERS =====================

model Cart {
  id        String  @id @default(uuid())
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id])
  sessionId String? @unique

  items    CartItem[]
  currency Currency   @default(RUB)
  total    Decimal    @default(0.00) @db.Decimal(15, 2)

  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  checkoutKey String? @unique
  checkoutRequestHash String?
  guestAccessHash String?
  guestAccessExpiresAt DateTime?
  reservationState String @default("LEGACY")
  reservationExpiresAt DateTime?
  bonusAmount Int @default(0)
  giftCardAmount Decimal @default(0.00) @db.Decimal(15, 2)
  giftCards GiftCard[]
  giftRedemption GiftCardRedemption?
  promoCode String?
  priceSnapshot Json?
  loyaltyAccruedAt DateTime?
  partnerCode String?
  partnerAttribution PartnerAttribution?
  partnerReward PartnerReward?
  promoRedemption PromoRedemption?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  b2bProfileId String?
  b2bProfile   B2BProfile? @relation(fields: [b2bProfileId], references: [id])

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  status OrderStatus @default(NEW)
  source OrderSource @default(WEB)

  externalOrderId String?
  buyerName       String?
  buyerEmail      String?
  buyerPhone      String?
  sourcePayload   Json?
  deliveryDate    DateTime?

  items          OrderItem[]
  totalAmount    Decimal     @db.Decimal(15, 2)
  discountAmount Decimal     @default(0.00) @db.Decimal(15, 2)
  finalAmount    Decimal     @db.Decimal(15, 2)
  currency       Currency    @default(RUB)

  shippingAddress  Json
  shippingProvider String?
  shippingCost     Decimal @default(0.00) @db.Decimal(15, 2)
  trackingNumber   String?

  paymentStatus String  @default("PENDING")
  paymentMethod String?

  sourceChannel String  @default("WEB")
  managerId     String?
  manager       User?   @relation("ManagerOrders", fields: [managerId], references: [id])

  comments      String?
  internalNotes String?

  externalId          String?   @unique
  isSynced1C          Boolean   @default(false)
  oneCStatus          String?
  oneCSyncAt          DateTime?
  oneCSyncError       String?
  warehouseDocumentId String?
  pickingStartedAt    DateTime?
  pickedAt            DateTime?
  packedAt            DateTime?

  history            OrderStatusHistory[]
  payments           Payment[]
  helpdeskTickets    HelpdeskTicket[]
  marketplaceStaging MarketplaceOrder?    @relation("CanonicalMarketplaceOrder")
  tasks              Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalOrderId])
  @@index([orderNumber])
  @@index([userId])
  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@index([source, status])
  @@index([externalId])
  @@index([isSynced1C, source])
  @@index([warehouseDocumentId])
}

model PartnerProgramSetting {
