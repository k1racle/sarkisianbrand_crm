}

// ===================== CRM =====================

model CrmPipeline {
  id             String             @id @default(uuid())
  name           String             @unique
  isDefault      Boolean            @default(false)
  isActive       Boolean            @default(true)
  requiredFields String[]           @default([])
  lostReasons    String[]           @default([])
  stages         CrmPipelineStage[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([isActive, isDefault])
}

model CrmPipelineStage {
  id          String      @id @default(uuid())
  pipelineId  String
  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  code        String
  color       String      @default("#f8604a")
  sortOrder   Int         @default(0)
  probability Int         @default(0)
  isWon       Boolean     @default(false)
  isLost      Boolean     @default(false)
  leads       Lead[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([pipelineId, code])
  @@index([pipelineId, sortOrder])
}

model Lead {
  files CrmLeadFile[]
  id             String        @id @default(uuid())
  b2bProfileId   String?
  b2bProfile     B2BProfile?   @relation(fields: [b2bProfileId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  source  String
  status  LeadStatus        @default(NEW)
  stageId String?
  stage   CrmPipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  title           String?
  contactName     String
  contactPhone    String
  contactEmail    String?
  message         String?
  amount          Decimal   @default(0.00) @db.Decimal(15, 2)
  probability     Int       @default(0)
  expectedCloseAt DateTime?
  nextContactAt   DateTime?
  lostReason      String?
  tags            String[]  @default([])
  closedAt        DateTime?

  managerId   String?
  manager     User?   @relation("ManagerLeads", fields: [managerId], references: [id])
  createdById String?
  createdBy   User?   @relation("CrmLeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  interactions Interaction[]
  tasks        Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([organizationId])
  @@index([stageId, managerId])
  @@index([expectedCloseAt])
}

model Interaction {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  type     String
  content  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  status   TaskStatus @default(TODO)
  priority String     @default("MEDIUM")
  progress Int        @default(0)
  position Int        @default(0)
  labels   String[]   @default([])

  startDate       DateTime?
  dueDate         DateTime?
  estimateMinutes Int?

  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id])
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         Task?             @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Task[]            @relation("TaskHierarchy")
  comments       CrmTaskComment[]
  files          CrmTaskFile[]
  publication    CrmPublication?
  reminders      CrmTaskReminder[]
  templateId     String?
  template       CrmTaskTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  completedAt DateTime?

  @@index([status, position])
  @@index([assignedToId, dueDate])
  @@index([startDate, dueDate])
  @@index([leadId])
  @@index([customerId])
  @@index([organizationId])
  @@index([orderId])
  @@index([templateId])
}

// One publication is a platform-specific version of an idea; production uses an ordinary task.
model CrmPublication {
  id            String   @id @default(uuid())
  taskId        String   @unique
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  ideaId        String
  platform      String
  format        String
  campaign      String   @default("")
  brief         String   @default("")
  script        String   @default("")
  caption       String   @default("")
  cta           String   @default("")
  status        String   @default("IDEA")
  scheduledAt   DateTime?
  timezone      String   @default("Europe/Moscow")
  publishedUrl  String   @default("")
  approvedAt    DateTime?
  approvedById  String?
  version       Int      @default(1)
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([archivedAt, scheduledAt])
  @@index([ideaId])
  @@index([status, platform])
}

model CrmTaskTemplate {
  id                String   @id @default(uuid())
  name              String   @unique
  title             String
  description       String?
  priority          String   @default("MEDIUM")
  labels            String[] @default([])
  estimateMinutes   Int?
  dueInHours        Int?
  reminderBeforeMin Int?     @default(60)
  defaultAssigneeId String?
  defaultAssignee   User?    @relation("TaskTemplateAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User     @relation("TaskTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  isActive          Boolean  @default(true)
  tasks             Task[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, name])
}

model CrmTaskReminder {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("TaskReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  deliveredAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([taskId, recipientId, remindAt])
  @@index([recipientId, remindAt, dismissedAt])
}

model CrmTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// Private CRM drive; bytes are never exposed through the public media service.
model CrmDriveNode {
  id          String   @id @default(uuid())
  name        String
  kind        String   // FOLDER or FILE
  scope       String   // PERSONAL or TEAM
  ownerId     String
  parentId    String?
  parent      CrmDriveNode?  @relation("DriveTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    CrmDriveNode[] @relation("DriveTree")
  storageKey  String?  @unique
  mime        String?
  size        Int     @default(0)
  deletedAt   DateTime?
  trashBatch  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       CrmTaskFile[]
  leads       CrmLeadFile[]

  @@index([scope, ownerId, parentId, deletedAt])
  @@index([trashBatch])
}

model CrmTaskFile {
  taskId    String
  nodeId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  node      CrmDriveNode  @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())
  @@id([taskId, nodeId])
}

model CrmLeadFile {
  leadId String
  nodeId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  node CrmDriveNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@id([leadId, nodeId])
}

model CrmChatChannel {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  type        CrmChatType      @default(TEAM)
  isArchived  Boolean          @default(false)
  createdById String
  createdBy   User             @relation("CrmChannelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     CrmChatMember[]
  messages    CrmChatMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, isArchived])
}

model CrmChatMember {
  channelId  String
  channel    CrmChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String         @default("MEMBER")
  lastReadAt DateTime?
  isMuted    Boolean        @default(false)
  joinedAt   DateTime       @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

model CrmChatMessage {
  id          String                   @id @default(uuid())
  channelId   String
  channel     CrmChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                     @relation("CrmMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  replyToId   String?
  replyTo     CrmChatMessage?          @relation("CrmMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     CrmChatMessage[]         @relation("CrmMessageReplies")
  attachments PlatformChatAttachment[]
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime                 @default(now())

  @@index([channelId, createdAt])
  @@index([authorId, createdAt])
}

model PlatformChatAttachment {
  id         String                     @id @default(uuid())
  messageId  String
  message    CrmChatMessage             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind       PlatformChatAttachmentKind
  name       String
  mimeType   String?
  size       Int?
  storageKey String?
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime                   @default(now())

  @@index([messageId])
  @@index([entityType, entityId])
}

// ===================== HELPDESK =====================

model HelpdeskTicket {
  id          String         @id @default(uuid())
  number      String         @unique
  subject     String
  description String
  source      TicketSource
  status      TicketStatus   @default(NEW)
  priority    TicketPriority @default(MEDIUM)
  queue       String         @default("Первая линия")

  requesterUserId String?
  requesterUser   User?   @relation("TicketRequester", fields: [requesterUserId], references: [id])
  requesterName   String?
  requesterEmail  String?

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  organizationRef String?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  affectedService String?

  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?

  comments  HelpdeskComment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, priority])
  @@index([queue, assignedToId])
  @@index([requesterUserId])
  @@index([customerId])
  @@index([organizationId])
  @@index([createdAt])
}

model HelpdeskComment {
  id         String         @id @default(uuid())
  ticketId   String
  ticket     HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?          @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([ticketId, createdAt])
}

// ===================== INTEGRATIONS =====================

model SyncLog {
  id        String   @id @default(uuid())
  system    String
  action    String
  status    String
  message   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([system])
  @@index([createdAt])
}

model JobRun {
  id            String       @id @default(uuid())
  queueName     String
  jobName       String
  externalJobId String?      @unique
  status        JobRunStatus @default(WAITING)
  progress      Int          @default(0)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(4)
  input         Json?
  result        Json?
  error         String?
  correlationId String       @default(uuid())
  initiatedById String?
  startedAt     DateTime?
  finishedAt    DateTime?
  nextRetryAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([queueName, jobName])
  @@index([correlationId])
}

model IdempotencyKey {
  key       String   @id
  requestId String
  response  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PromoCode {
  code String @id
  title String
  discountType String
  amount Decimal @db.Decimal(15,2)
  minimumAmount Decimal @default(0) @db.Decimal(15,2)
  maximumDiscount Decimal? @db.Decimal(15,2)
  usageLimit Int?
  perCustomerLimit Int @default(1)
  isActive Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  revision Int @default(1)
  redemptions PromoRedemption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoRedemption {
  id String @id @default(uuid())
  code String
  promo PromoCode @relation(fields:[code],references:[code])
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id])
  customerHash String
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  @@index([code,status])
  @@index([code,customerHash,status])
}

model ShippingQuote {
  id String @id @default(uuid())
  sessionHash String
  provider String
  deliveryMethod String
  amount Decimal @db.Decimal(15,2)
  currency String @default("RUB")
  destinationHash String
  requestSnapshot Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model MailOutbox {
  id String @id @default(uuid())
  dedupeKey String @unique
  kind String
  recipient String
  encryptedPayload String
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,nextAttemptAt])
}

model ContactFormSetting {
  key            String   @id @default("main")
  recipientEmail String?
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id                 String    @id @default(uuid())
  name               String
  phone              String
  email              String
  message            String
  notificationStatus String    @default("DISABLED")
  mailOutboxId       String?
  createdAt          DateTime  @default(now())
  readAt             DateTime?

  @@index([createdAt])
  @@index([readAt, createdAt])
}

// ===================== SEO =====================

model SeoData {
  id         String    @id @default(uuid())
  entityType String
  entityId   String    @unique
  categoryId String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?   @unique
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  metaTitle  String?
  metaDesc   String?
  canonical  String?
  ogImage    String?

  updatedAt DateTime @updatedAt
}

// ===================== LMS =====================

model Course {
  id          String       @id @default(uuid())
  titleRu     String
  titleEn     String?
  description Json?
  price       Decimal      @db.Decimal(15, 2)
  isActive    Boolean      @default(true)
  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id        String  @id @default(uuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  title     String
  videoUrl  String?
  content   String?
  sortOrder Int     @default(0)
}

model Enrollment {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  progress          Int      @default(0)
  isCompleted       Boolean  @default(false)
  certificateIssued Boolean  @default(false)
  enrolledAt        DateTime @default(now())

  @@unique([userId, courseId])
}

// ===================== BOOKING =====================

model Service {
  id       String    @id @default(uuid())
  titleRu  String
  duration Int
  price    Decimal   @db.Decimal(15, 2)
  isActive Boolean   @default(true)
  bookings Booking[]
}

model Booking {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
}
